map $http_x_forwarded_proto $audrey_forwarded_proto {
    default $http_x_forwarded_proto;
    "" $scheme;
}

# Leave an upstream cache policy intact. An empty add_header value emits
# nothing, so API streams/downloads retain their own single Cache-Control.
map $upstream_http_cache_control $audrey_api_cache_control {
    default "";
    "" "no-store";
}

# Only successful asset responses are immutable. Missing assets must remain
# recoverable after a deployment, even when the request hits an error response.
map $status $audrey_asset_cache_control {
    default "no-store";
    200 "public, max-age=31536000, immutable";
    206 "public, max-age=31536000, immutable";
    304 "public, max-age=31536000, immutable";
}

map $uri $audrey_cache_control {
    default "no-store";
    ~^/(api|v1)(/|$) $audrey_api_cache_control;
    /openapi.json $audrey_api_cache_control;
    ~^/assets/ $audrey_asset_cache_control;
}

server {
    listen 8080;
    server_name _;
    server_tokens off;

    # Docker may assign Audrey a new address whenever its container is
    # recreated. Resolve the service name at request time so this long-lived
    # proxy does not keep sending API traffic to the retired address.
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $audrey_upstream ${AUDREY_UPSTREAM};

    root /usr/share/nginx/html;
    index index.html;
    client_max_body_size ${AUDREY_UI_MAX_BODY_SIZE};

    # Keep these at server scope so static and API responses inherit the same
    # security headers. The maps preserve upstream cache policy without adding
    # a duplicate; responses without one (including errors) use no-store.
    add_header Cache-Control $audrey_cache_control always;
    add_header Content-Security-Policy "default-src 'self'; connect-src 'self'; img-src 'self' data:; style-src 'self'; font-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Referrer-Policy "same-origin" always;
    add_header X-Content-Type-Options "nosniff" always;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Keep Audrey's browser/API contract same-origin. Disabling buffering for
    # all API traffic preserves AG-UI and OpenAI SSE, while request streaming
    # avoids a second full copy of uploads inside the UI container.
    location ~ ^/(api|v1)(/|$) {
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Proto $audrey_forwarded_proto;
        proxy_set_header Cf-Access-Jwt-Assertion $http_cf_access_jwt_assertion;
        proxy_buffering off;
        proxy_cache off;
        proxy_request_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_pass $audrey_upstream;
    }

    location = /openapi.json {
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $audrey_forwarded_proto;
        proxy_set_header Cf-Access-Jwt-Assertion $http_cf_access_jwt_assertion;
        proxy_pass $audrey_upstream;
    }

    location ^~ /assets/ {
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
