map $http_x_forwarded_proto $audrey_forwarded_proto {
    default $http_x_forwarded_proto;
    "" $scheme;
}

map $uri $audrey_cache_control {
    default "no-store";
    ~^/assets/ "public, max-age=31536000, immutable";
}

server {
    listen 8080;
    server_name _;
    server_tokens off;

    root /usr/share/nginx/html;
    index index.html;
    client_max_body_size ${AUDREY_UI_MAX_BODY_SIZE};

    # Do not attach the immutable asset policy to an asset 404: A browser or
    # edge cache must be able to recover after the next deployment.
    add_header Cache-Control $audrey_cache_control;
    add_header Content-Security-Policy "default-src 'self'; connect-src 'self'; img-src 'self' data:; style-src 'self'; font-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Referrer-Policy "same-origin" always;
    add_header X-Content-Type-Options "nosniff" always;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Keep Audrey's browser/API contract same-origin. Disabling buffering for
    # all API traffic preserves AG-UI and OpenAI SSE, while request streaming
    # avoids a second full copy of uploads inside the UI container.
    location ~ ^/(api|v1)(/|$) {
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Proto $audrey_forwarded_proto;
        proxy_set_header Cf-Access-Jwt-Assertion $http_cf_access_jwt_assertion;
        proxy_buffering off;
        proxy_cache off;
        proxy_request_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_pass ${AUDREY_UPSTREAM};
    }

    location = /openapi.json {
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $audrey_forwarded_proto;
        proxy_set_header Cf-Access-Jwt-Assertion $http_cf_access_jwt_assertion;
        proxy_pass ${AUDREY_UPSTREAM};
    }

    location ^~ /assets/ {
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
