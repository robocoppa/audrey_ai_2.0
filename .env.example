# Copy this file to .env and fill in real values on Unraid.
# Never commit .env — it's in .gitignore.

# ─── Core ─────────────────────────────────────────────────────────────
# The image already sets AUDREY_CONFIG=/app/config.yaml. Uncomment only when
# running the same image with a config mounted somewhere else.
# AUDREY_CONFIG=/app/config.yaml
# Host path to this repo on Unraid, used only for Docker tab icon labels.
AUDREY_REPO_DIR=/mnt/user/appdata/audrey_ai_2.0

# ─── Ollama ───────────────────────────────────────────────────────────
# Inside ollama-net, the hostname is just "ollama".
# For local dev on the laptop, set to http://localhost:11434.
OLLAMA_HOST=http://ollama:11434

# ─── Brave Search API ─────────────────────────────────────────────────
# Get a key at https://api.search.brave.com/app/keys
# Free tier is fine for v1 (2k queries/month, 1 qps).
BRAVE_API_KEY=

# ─── Qdrant ───────────────────────────────────────────────────────────
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334

# ─── Tool server ──────────────────────────────────────────────────────
# config.yaml tools.servers is authoritative. Uncomment only for a
# deployment-specific override; every active override is logged at startup.
# TOOL_SERVERS=http://custom-tools:8001

# ─── Knowledge base and uploads ─────────────────────────────────────────
# config.yaml kb.dataset_paths is authoritative. Uncomment only for a
# deployment-specific comma-separated override.
# KB_DATASET_PATHS=/datasets/geology,/datasets/botany
# Upload roots, upload limits, and the CLIP cache live under config.yaml kb.
# They deliberately have no parallel environment settings.

# ─── Auth (Phase 14) ──────────────────────────────────────────────────
# OWUI is the identity source. Audrey validates every /v1/files request
# by proxying the browser's bearer token to GET {OWUI_URL}/api/v1/auths/.
# Must be reachable from the audrey-ai container on ollama-net.
OWUI_URL=http://open-webui:8080

# The same OWUI, addressed the way a BROWSER reaches it. Different string,
# different job: OWUI_URL above resolves on ollama-net and nowhere else, so it
# cannot be put in a page. This is only used for the upload page's Home link —
# that page is opened in a new tab from an OWUI banner, so there is no history
# to go back through. Unset means no Home link is rendered at all, which is
# better than one that goes nowhere.
# OWUI_PUBLIC_URL=https://chat.example.com

# Optional native Audrey browser authentication through Cloudflare Access.
# Disabled by default: Leaving this off preserves the current OWUI/PAT path.
# When enabled, Audrey verifies the Cf-Access-Jwt-Assertion header against the
# team's HTTPS JWKS, issuer, and application audience. Do not put an Access
# token here. The Access application must protect Audrey's entire public
# hostname because the browser also calls /api/*. Route that
# hostname directly to Audrey, not through Open WebUI. Both settings below are
# required when the flag is enabled.
# CLOUDFLARE_ACCESS_ENABLED=0
# CLOUDFLARE_ACCESS_TEAM_DOMAIN=https://your-team.cloudflareaccess.com
# CLOUDFLARE_ACCESS_AUDIENCE=your-application-aud-tag

# Native Audrey browser client. Disabled by default while Open WebUI remains
# the public surface. Enabling this serves the built application at `/`;
# it does not weaken or bypass the authentication rules on `/api/*`.
# AUDREY_NATIVE_UI_ENABLED=0

# ─── Memory (Qdrant-backed, semantic; Phase 12) ───────────────────────
# Collection name for per-user long-term memory. Separate from kb_text /
# kb_images so KB churn doesn't affect memory and vice versa.
MEMORY_COLLECTION=kb_memory
# Embedding model used for both memory writes and search queries. Must
# match the dim configured on the collection (nomic-embed-text = 768).
MEMORY_EMBED_MODEL=nomic-embed-text
# Cosine similarity floor for memory_search. nomic-embed-text runs warm —
# unrelated baseline ~0.4 — so 0.5 is the first value that cleanly
# separates on-topic hits from noise. Raise if you see false positives,
# lower if relevant memories get dropped.
MEMORY_SIMILARITY_THRESHOLD=0.5

# ─── Searchable chat archive ─────────────────────────────────────────
# SQLite is authoritative; Qdrant is a repairable semantic index.
# 0 retention keeps history forever. Maintenance still runs to retry failed
# indexing and any deletion already queued before a configuration change.
CHAT_ARCHIVE_RETENTION_DAYS=0
CHAT_ARCHIVE_MAINTENANCE_INTERVAL_S=300
CHAT_ARCHIVE_REPAIR_BATCH_SIZE=50
CHAT_ARCHIVE_MAX_RETRY_ATTEMPTS=5
# Reserved but deliberately rejected when nonzero: no byte-cap implementation
# exists yet, so custom-tools fails startup instead of pretending to enforce it.
CHAT_ARCHIVE_MAX_BYTES=0

# ─── Pipeline override opt-ins ─────────────────────────────────────────
# config.yaml is authoritative. These supported overrides are intentionally
# commented: uncomment one only for a deployment experiment, then confirm the
# startup ENV OVERRIDE warning and remove it when the experiment ends.
# COMPLEXITY_TOKEN_THRESHOLD=500
# GPU_CONCURRENCY=1
# TOOL_MAX_ROUNDS=5
# PLANNING_MIN_TOKENS=120
# MAX_DEEP_WORKERS_CLOUD=3
# MAX_INFLIGHT_PER_USER=3

# ─── Video job leases (Phase 33/34) ───────────────────────────────────
# Both override `kb.video` in config.yaml. Left commented out so the YAML
# stays the source of truth. Uncomment VIDEO_LEASE_MINUTES=1 to run the lease
# verification without editing config.yaml on the box — then comment it out
# again, because production wants 30 and a forgotten override is invisible.
# Takes effect on `docker compose up -d audrey-ai`.
# VIDEO_LEASE_MINUTES=1
# VIDEO_MAX_ATTEMPTS=3

# ─── Diagnostic traces ────────────────────────────────────────────────
# Both override `agentic.debug_*_trace` in config.yaml. Set them HERE, not in
# the YAML: config.yaml is tracked and changes often, so a flag flipped there
# leaves a diff every later `git pull` has to be worked around. `.env` is
# gitignored, so an override set here survives every pull untouched.
#
# DEBUG_CONTEXT_TRACE logs one `context-trace:` line per ReAct round and one
# marked FINAL just before the forced final answer, carrying the live tool
# results with their sizes, how many compaction stubbed out, and the total
# conversation length. It is how "the model invented that it could not read
# the file" gets told apart from "the model was handed one page of four".
# Log-only, never client-visible. Turn on for a run, then comment out again.
# Takes effect on `docker compose up -d --force-recreate audrey-ai`.
# DEBUG_CONTEXT_TRACE=1
# DEBUG_RESEARCH_TRACE=1
# DEBUG_PANEL_DRAFTS=1
# COMPLEXITY_LOG_BREAKDOWN=1
# LOG_INCOMING_PAYLOAD=1
# ⚠️ PII-BEARING: logs the first 500 chars of every incoming message. On for a
# single debugging session, then off. Setting it here rather than in
# config.yaml means it cannot survive a deploy as a forgotten file diff, and it
# shows up in the startup ENV OVERRIDE warning while it is on.
# LOG_INCOMING_PAYLOAD_CONTENT=1

# ─── ReAct compaction dials (A-B-A experiments) ───────────────────────
# Override `agentic.react.*`. Here because the A-B-A rule makes each
# experiment THREE edits — set, revert, set again — and doing that in
# config.yaml dirties a tracked file on a live box every time.
#   REACT_COMPRESS_KEEP_LAST      tool messages kept verbatim past compaction
#   REACT_COMPRESS_AFTER_ROUND    round at which compaction starts
#   REACT_MAX_TOOL_RESULT_CHARS   per-result truncation
# ⚠️ A forgotten override is invisible in config.yaml — audrey-ai logs every
# active one at startup as a WARNING, so `docker compose logs audrey-ai |
# grep "ENV OVERRIDE"` answers "what is this box actually running".
# REACT_COMPRESS_KEEP_LAST=1
# REACT_COMPRESS_AFTER_ROUND=2
# REACT_MAX_TOOL_RESULT_CHARS=6000

# ─── Passthrough thinking (bake-off A-B) ──────────────────────────────
# Overrides `passthrough.think`. Unset means the YAML wins, and the YAML ships
# `null` — no `think` field sent, which is what serving clients should get.
#
# Set it only to A-B a model sweep. The eval harness reaches its models through
# the passthrough route, so without this every candidate is compared in
# Ollama's `omitted` state — whatever each model's template decides. Probed
# 2026-08-12: `omitted` and `true` were within the run-to-run spread on all
# three bake-off models, so the default IS thinking and nobody chose it.
#   PASSTHROUGH_THINK=0   thinking off  (models that declare the capability)
#   PASSTHROUGH_THINK=1   thinking on
# ⚠️ Never reaches a model that does not declare `thinking` — Ollama errors on
# the field rather than ignoring it, so `ollama.thinking_flag` drops it. Safe
# to set while `allowed_models` holds a mix.
# ⚠️ Passthrough is what Claudette/Hermes/OpenClaw use. A forgotten value here
# changes what those clients get, silently — it shows in the startup ENV
# OVERRIDE warning, which is the only place it will announce itself.
# Takes effect on `docker compose up -d --force-recreate audrey-ai`.
# PASSTHROUGH_THINK=0

# ─── Open WebUI (set on the open-webui container, not here) ───────────
# OPENAI_API_BASE_URL=http://audrey-ai:8000/v1
# OPENAI_API_KEY=unused
# WEBUI_AUTH=true
# ENABLE_SIGNUP=true

# ─── Live eval harness (scripts/eval_research.py) — LAPTOP ONLY ───────
# These do NOT go in this file. Put them in `.env.test.local` (its own
# gitignored file, separate from this app config) — the eval script reads
# that, runs from the laptop over the LAN/VPN (not in any container). Mint the
# key in OWUI → Settings → Account → API Keys. Never commit a real key.
# .env.test.local:
#   AUDREY_EVAL_BASE_URL=http://192.168.1.11:8080/api   # OWUI host:port + /api
#   AUDREY_EVAL_API_KEY=sk-...
